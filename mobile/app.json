{
  "expo": {
    "name": "하고봐",
    "slug": "hagobwa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hagobwa",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.hagobwa.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "운동 횟수를 세기 위해 카메라를 사용해요. 영상은 기기 밖으로 나가지 않아요.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hagobwa.app",
      "adaptiveIcon": {
        "backgroundColor": "#E0454A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "하고봐",
      "themeColor": "#ECEDE7",
      "backgroundColor": "#F7F7F3"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E0454A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "react-native-device-activity",
        {
          "appGroup": "group.com.hagobwa.app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5e9eb89b-b3bf-4728-affa-34a5146f1086"
      }
    },
    "owner": "hwanifys-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/5e9eb89b-b3bf-4728-affa-34a5146f1086",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
