#!/usr/bin/expect -f
# One-time iOS signing setup on EAS, run from CI.
#
# `eas credentials:configure-build` has no non-interactive mode, so this drives its prompts:
# it answers "yes" to create the Apple Distribution Certificate and Provisioning Profile and
# picks the default for list prompts. Apple auth comes from the App Store Connect API key in
# EXPO_ASC_API_KEY_PATH / EXPO_ASC_KEY_ID / EXPO_ASC_ISSUER_ID (no Apple ID password, no 2FA).

set timeout 600
log_user 1

spawn npx eas-cli credentials:configure-build --platform ios --profile production

expect {
  -re {Apple ID:|Password \(for} {
    puts "\n\[setup] eas-cli asked for an Apple ID login. Check the EXPO_ASC_* secrets: the API key was not picked up."
    exit 3
  }
  -re {revoke|Delete|remove|Removing} {
    send "n\r"
    exp_continue
  }
  -re {\(Y/n\)|\(y/N\)|\(y/n\)} {
    send "y\r"
    exp_continue
  }
  -re {Select|Choose|Which} {
    send "\r"
    exp_continue
  }
  timeout {
    puts "\n\[setup] timed out waiting for eas-cli"
    exit 4
  }
  eof
}

lassign [wait] pid spawnid os_error status
exit $status
